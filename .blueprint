models:
    User: { id: id@increments, email: email@unique, passwordHash: string, googleAuthId: string@nullable, timezone: string, timestamps: timestamps }
    Client: { id: id@increments, name: string, user_id: "belongsTo('User')", timestamps: timestamps }
    Project: { id: id@increments, name: string, hourlyRate: float@nullable, dailyRate: float@nullable, client_id: "belongsTo('Client')", timestamps: timestamps }
    Timer: { id: id@increments, startTime: dateTime, endTime: dateTime@nullable, manualEntry: boolean, updatedManually: boolean, user_id: "belongsTo('User')", project_id: "belongsTo('Project')", timestamps: timestamps }
    Report: { id: id@increments, name: string, filePath: string, user_id: "belongsTo('User')", timestamps: timestamps }
